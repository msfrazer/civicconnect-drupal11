{% set category = fields.field_event_category.content|default('')|striptags|trim %}

{% if not category and row._entity.field_event_category.value %}
  {% set category = row._entity.field_event_category.value %}
{% endif %}

<article class="event-card">

  <div class="event-card__image">
    {{ fields.field_event_image.content }}
  </div>

  <div class="event-card__content">

    {% if category %}
      <div class="event-card__category">
        {{ category }}
      </div>
    {% endif %}

    <h2 class="event-card__title">
      {{ fields.title.content }}
    </h2>

    <div class="event-card__meta">

      <div class="event-card__date">
        <svg
          class="event-card__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false">
          <path d="M7 2v3M17 2v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/>
        </svg>

        <span>{{ fields.field_event_date.content }}</span>
      </div>

      <div class="event-card__location">
        <svg
          class="event-card__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false">
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/>
          <circle cx="12" cy="10" r="2.5"/>
        </svg>

        <span>{{ fields.field_event_location.content }}</span>
      </div>

    </div>

    <div class="event-card__summary">
      {{ fields.field_event_summary.content }}
    </div>

    {% set volunteer_spots =
  fields.field_volunteer_spots_available.content
  |striptags
  |trim
%}

{% if volunteer_spots %}
  <div class="event-card__spots">
    <svg
      class="event-card__icon"
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false">
      <circle cx="9" cy="8" r="3"/>
      <circle cx="17" cy="9" r="2.5"/>
      <path d="M3 20c0-4 2.5-7 6-7s6 3 6 7M14 14c3 0 5 2.5 5 6"/>
    </svg>

    <span>{{ volunteer_spots }} volunteer spots available</span>
  </div>
{% endif %}

    <div class="event-card__link">
      {{ fields.field_button_link.content }}
    </div>

  </div>

</article>
