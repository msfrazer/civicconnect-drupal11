<section{{ attributes.addClass('cta') }}>
  <div class="cta__inner">
    {% if paragraph.field_heading.value %}
      <h2 class="cta__title">
        {{ paragraph.field_heading.value }}
      </h2>
    {% endif %}

    {% if content.field_description %}
      <div class="cta__description">
        {{ content.field_description }}
      </div>
    {% endif %}

    {% if paragraph.field_button_link.0.url and paragraph.field_button_text.value %}
      <a
        class="button button--secondary"
        href="{{ paragraph.field_button_link.0.url }}"
      >
        {{ paragraph.field_button_text.value }}
      </a>
    {% endif %}
  </div>
</section>
