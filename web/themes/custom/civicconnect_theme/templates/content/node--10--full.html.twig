<article{{ attributes.addClass('contact-page') }}>

  <section class="contact-hero">
    <p class="contact-hero__eyebrow">Contact CivicConnect</p>

    <h1 class="contact-hero__title">
      Let’s Connect
    </h1>

    <p class="contact-hero__description">
      Have a question, need help finding a local resource, or want to share a community opportunity? Send us a message.
    </p>
  </section>

  <section class="contact-layout">

    <div class="contact-form-card">

      <h2>Send a Message</h2>

      <form class="contact-form" action="#" method="post">

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-name">Name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required>
          </div>

          <div class="contact-form__field">
            <label for="contact-email">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required>
          </div>
        </div>

        <div class="contact-form__field">
          <label for="contact-subject">Subject</label>
          <input
            id="contact-subject"
            name="subject"
            type="text"
            required>
        </div>

        <div class="contact-form__field">
          <label for="contact-message">Message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="7"
            required></textarea>
        </div>

        <button class="contact-form__submit" type="submit">
          Send Message
        </button>

      </form>

    </div>

    <aside class="contact-info-card">

      <h2>Contact Information</h2>

      <p class="contact-info-card__intro">
        We’re here to help residents connect with community resources, events, and volunteer opportunities.
      </p>

      <div class="contact-info-list">

        <div class="contact-info-item">
          <svg
            class="contact-info-item__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false">
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/>
            <circle cx="12" cy="10" r="2.5"/>
          </svg>

          <div>
            <span class="contact-info-item__label">Location</span>
            <span>Greenbelt, Maryland</span>
          </div>
        </div>

        <div class="contact-info-item">
          <svg
            class="contact-info-item__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false">
            <path d="M4 4h16v16H4z"/>
            <path d="m4 6 8 6 8-6"/>
          </svg>

          <div>
            <span class="contact-info-item__label">Email</span>
            <a href="mailto:southerlandfrazerm@gmail.com">
              southerlandfrazerm@gmail.com
            </a>
          </div>
        </div>

        <div class="contact-info-item">
          <svg
            class="contact-info-item__icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false">
            <path d="M7 3h3l2 5-2 2a16 16 0 0 0 4 4l2-2 5 2v3c0 2-2 4-4 4C9 21 3 15 3 7c0-2 2-4 4-4Z"/>
          </svg>

          <div>
            <span class="contact-info-item__label">Phone</span>
            <a href="tel:+12405360785">
              (240) 536-0785
            </a>
          </div>
        </div>

      </div>

      <div class="contact-info-card__hours">
        <h3>Response Time</h3>
        <p>Messages are typically reviewed within one to two business days.</p>
      </div>

    </aside>

  </section>

</article>
